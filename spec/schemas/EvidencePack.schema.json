{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repo-tutor.dev/schemas/EvidencePack.schema.json",
  "title": "EvidencePack",
  "description": "Curated code context sent to LLM for chapter generation",
  "type": "object",
  "properties": {
    "chapterId": {
      "type": "string",
      "description": "The chapter this evidence supports"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Relative path to the file"
          },
          "language": {
            "type": "string",
            "description": "Programming language of the file"
          },
          "content": {
            "type": "string",
            "description": "File content (may be truncated)"
          },
          "truncated": {
            "type": "boolean",
            "description": "Whether the content was truncated"
          },
          "tier": {
            "type": "string",
            "enum": ["A", "B", "C", "D"],
            "description": "Relevance tier (A=primary, D=reference)"
          },
          "headTailTruncated": {
            "type": "boolean",
            "description": "Whether head+tail truncation was applied (preserves imports and exports)"
          },
          "relevantLines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "integer" },
                "end": { "type": "integer" },
                "reason": { "type": "string" }
              },
              "required": ["start", "end"]
            },
            "description": "Specific line ranges that are most relevant"
          }
        },
        "required": ["path", "content"]
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["function", "class", "method", "variable", "type", "interface"]
          },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "signature": { "type": "string" }
        },
        "required": ["name", "kind", "file"]
      },
      "description": "Key symbols relevant to the chapter"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": ["from", "to"]
      },
      "description": "Import/dependency relationships"
    },
    "redactionsApplied": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of redaction rules that were applied"
    },
    "totalTokensEstimate": {
      "type": "integer",
      "description": "Estimated token count for this evidence pack"
    },
    "budgetUsed": {
      "type": "integer",
      "description": "Actual chars consumed across all files"
    },
    "interfaceArtifact": {
      "type": "object",
      "description": "Structural summary of the repo's architecture",
      "properties": {
        "directoryTree": {
          "type": "string",
          "description": "Indented tree of relevant directories and files"
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "confidence": { "type": "number" },
              "keySignals": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["id", "label", "confidence"]
          }
        },
        "entryPoints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frameworkStack": {
          "type": "array",
          "items": { "type": "string" }
        },
        "moduleMap": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string" },
              "fileCount": { "type": "integer" },
              "purpose": { "type": "string" }
            },
            "required": ["name", "path", "fileCount"]
          }
        }
      },
      "required": ["directoryTree", "tracks", "entryPoints", "frameworkStack", "moduleMap"]
    }
  },
  "required": ["chapterId", "files"]
}
