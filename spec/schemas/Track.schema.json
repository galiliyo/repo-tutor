{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repo-tutor.dev/schemas/Track.schema.json",
  "title": "Track",
  "description": "A learning track grouping related chapters by domain",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "enum": ["frontend", "backend", "architecture", "infra"],
      "description": "Unique track identifier"
    },
    "label": {
      "type": "string",
      "description": "Display label for the track"
    },
    "description": {
      "type": "string",
      "description": "Short description of what this track covers"
    },
    "focusTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "structure",
          "entry-point",
          "data-flow",
          "module",
          "pattern",
          "bootstrap",
          "state-management",
          "http",
          "database",
          "auth",
          "error-handling"
        ]
      },
      "description": "ChapterFocus values typically associated with this track"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Detection confidence score (0-1)"
    },
    "suggestedOrder": {
      "type": "integer",
      "minimum": 1,
      "description": "Recommended learning order among tracks"
    }
  },
  "required": ["id", "label", "description", "focusTypes", "confidence", "suggestedOrder"]
}
