{
  "name": "repo-tutor",
  "displayName": "Repo Tutor",
  "description": "Learn unfamiliar codebases through guided chapters and quizzes",
  "version": "0.1.0",
  "publisher": "repo-tutor",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repo-tutor.startLearning",
        "title": "Start Learning",
        "category": "Repo Tutor",
        "icon": "$(play)"
      },
      {
        "command": "repo-tutor.configureApiKey",
        "title": "Configure API Key",
        "category": "Repo Tutor",
        "icon": "$(key)"
      },
      {
        "command": "repo-tutor.refreshChapters",
        "title": "Refresh Chapters",
        "category": "Repo Tutor",
        "icon": "$(refresh)"
      },
      {
        "command": "repo-tutor.clearSession",
        "title": "Clear Session",
        "category": "Repo Tutor",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "repo-tutor.refreshChapters",
          "when": "view == repo-tutor.chapters",
          "group": "navigation"
        },
        {
          "command": "repo-tutor.clearSession",
          "when": "view == repo-tutor.chapters"
        }
      ]
    },
    "configuration": {
      "title": "Repo Tutor",
      "properties": {
        "repoTutor.llm.provider": {
          "type": "string",
          "default": "ollama",
          "enum": [
            "anthropic",
            "openai",
            "gemini",
            "openrouter",
            "groq",
            "ollama"
          ],
          "enumDescriptions": [
            "Anthropic Claude",
            "OpenAI GPT",
            "Google Gemini",
            "OpenRouter (multi-provider)",
            "Groq (fast inference)",
            "Ollama (Local, Free)"
          ],
          "description": "LLM provider to use"
        },
        "repoTutor.llm.model": {
          "type": "string",
          "default": "llama3",
          "description": "Model to use for generation"
        },
        "repoTutor.llm.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server URL"
        },
        "repoTutor.logging.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Log full LLM prompts and responses (for debugging)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repo-tutor",
          "title": "Repo Tutor",
          "icon": "resources/book.svg"
        }
      ]
    },
    "views": {
      "repo-tutor": [
        {
          "type": "webview",
          "id": "repo-tutor.modelConfig",
          "name": "Model"
        },
        {
          "id": "repo-tutor.chapters",
          "name": "Chapters"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "repo-tutor.chapters",
        "contents": "No learning session active.\n[Start Learning](command:repo-tutor.startLearning)\n\nOr configure your API key first:\n[Configure API Key](command:repo-tutor.configureApiKey)"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "pnpm build --watch",
    "package": "vsce package --no-dependencies",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@repo-tutor/core": "workspace:*",
    "marked": "^17.0.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
